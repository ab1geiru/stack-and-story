# Optional. Copy to server/.env to override defaults. The app runs without this file.

# Port for the Express API (and for the built app when using `npm start`).
PORT=4000

# SQLite database location, relative to the server/ folder.
DATABASE_FILE=./data/stack-and-story.sqlite

# Secret used to sign session cookies. Leave empty to have one generated and stored locally on first run.
SESSION_SECRET=
