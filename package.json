{
  "name": "stack-and-story",
  "version": "1.0.0",
  "private": true,
  "description": "Stack & Story - A Builder's Journal. A local blog for the AWS Learning Club-UST Development Committee assessment.",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors cyan,magenta --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "db:init": "npm run db:init --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "test": "npm run test --workspace server",
    "check:permissions": "npm run check:permissions --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
